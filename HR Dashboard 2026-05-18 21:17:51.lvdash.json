{
  "datasets": [
    {
      "name": "hr_metrics",
      "displayName": "HR Metrics",
      "config": {
        "source": "workspace.hr_data.bronze_hr_dataset",
        "measures": [
          {
            "name": "Employee Count",
            "expr": "COUNT(DISTINCT EMP_ID)",
            "displayName": "Employee Count",
            "comment": "Total number of employees"
          },
          {
            "displayName": "Total Salary",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "Total Salary",
            "expr": "SUM(SALARY)",
            "comment": "Total salary expense"
          },
          {
            "displayName": "Average Salary",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "Average Salary",
            "expr": "AVG(SALARY)",
            "comment": "Average employee salary"
          },
          {
            "displayName": "Median Salary",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "Median Salary",
            "expr": "PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY SALARY)",
            "comment": "Median employee salary"
          },
          {
            "displayName": "Min Salary",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "Min Salary",
            "expr": "MIN(SALARY)",
            "comment": "Minimum salary"
          },
          {
            "displayName": "Max Salary",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "Max Salary",
            "expr": "MAX(SALARY)",
            "comment": "Maximum salary"
          }
        ],
        "version": 1.1,
        "comment": "HR employee metrics for workforce analytics",
        "dimensions": [
          {
            "name": "Department",
            "expr": "DEPARTMENT",
            "displayName": "Department",
            "comment": "Employee department"
          },
          {
            "name": "Job Title",
            "expr": "JOB_TITLE",
            "displayName": "Job Title",
            "comment": "Employee job title"
          },
          {
            "name": "Location",
            "expr": "LOCATION",
            "displayName": "Location",
            "comment": "Employee work location"
          },
          {
            "name": "City",
            "expr": "CITY",
            "displayName": "City",
            "comment": "Employee city"
          },
          {
            "name": "State",
            "expr": "STATE",
            "displayName": "State",
            "comment": "Employee state"
          },
          {
            "name": "Education Level",
            "expr": "EDUCATION_LEVEL",
            "displayName": "Education Level",
            "comment": "Employee education level"
          },
          {
            "name": "Hire Year",
            "expr": "YEAR(HIRE_DT)",
            "displayName": "Hire Year",
            "comment": "Year employee was hired"
          },
          {
            "name": "Hire Month",
            "expr": "DATE_TRUNC('MONTH', HIRE_DT)",
            "displayName": "Hire Month",
            "comment": "Month employee was hired"
          }
        ]
      }
    }
  ],
